
{
  "$schema": "https://opencode.ai/config.json",
    "agent": {
    "build": {
      "mode": "primary",
      "model": "anthropic/claude-opus-4-5-20251101",
      "description": "Lead Developer: Heavy coding and logic "
    },
    "plan": {
      "mode": "primary",
      "model": "anthropic/claude-opus-4-5-20251101",
      "description": "Architect: High-level planning ",
      "write": false
    },
    "freebuilder": {
      "mode": "primary",
      "model": "openrouter/openrouter/aurora-alpha",
      "description": "Lead Developer: Heavy coding and logic "
    },
    "freeplanner": {
      "mode": "primary",
      "model": "openrouter/openrouter/aurora-alpha",
      "description": "Architect: High-level planning",
      "write": false
    },
    "herochun": {
      "mode": "primary",
      "model": "openrouter/qwen/qwen3-coder-next",
      "description": "Lead Developer: Heavy coding and logic (Claude Pro)",
      "fallback": false
    },
    "bobthebuilder": {
      "mode": "primary",
      "model": "openrouter/z-ai/glm-5",
      "description": "Lead Developer: Heavy coding and logic (Claude Pro)",
      "fallback": false
    },
    "juniorherochun": {
      "mode": "primary",
      "model": "openrouter/moonshotai/kimi-k2.5",
      "description": "Lead Developer: Heavy coding and logic (Claude Pro)",
      "fallback": false
    },
    "juniorbobthebuilder": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v3.2",
      "description": "Lead Developer: Heavy coding and logic (Claude Pro)",
      "fallback": false
    },

    "chinese-chun-minimax": {
      "mode": "subagent",
      "model": "openrouter/minimax/minimax-m2.1",
      "description": "Math Specialist: Solves complex proofs and verify logic.",
      "system": "You are a mathematical researcher. Use Chain-of-Thought reasoning to solve formulas and verify steps. Do not skip calculations.",
      "fallback": false
    },
    "internchun": {
      "mode": "subagent",
      "model": "openrouter/x-ai/grok-4.1-fast",
      "description": "Lead Developer: Heavy coding and logic (Claude Pro)",
      "fallback": false
    },
    "internchun2": {
      "mode": "subagent",
      "model": "openrouter/x-ai/grok-code-fast-1",
      "description": "Assistant: Boilerplate, logs, and small fixes (Free/Cheap)",
      "system": "You are a junior developer. Follow instructions exactly, don't overthink, and focus on speed for repetitive tasks like adding logs or fixing typos.",
      "fallback": false,
      "params": {
        "include_reasoning": false
      }
    },
     "tester-deep": {
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5-20251001",
      "description": "Scans the entire repo for issues mentioned",
      "system": "You are the final Quality control and Quality Assurance engineer before the code is realised to production. You have a 1M token window. Read all files in the 'src' folder.",
      "fallback": false
    },
    "tester-fast": {
      "mode": "subagent",
      "model": "openrouter/google/gemini-2.5-flash",
      "description": "Scans the entire repo for issues mentioned.",
      "system": "You are the final Quality control and Quality Assurance engineer before the code is realised to production. You have a 1M token window. Read all files in the 'src' folder.",
      "fallback": false
    },
    "qa-fast": {
      "mode": "subagent",
      "model": "openrouter/google/gemini-2.0-flash-001",
      "description": "Scans the entire repo for issues mentioned",
      "system": "You are the final Quality control and Quality Assurance engineer before the code is realised to production. You have a 1M token window. Read all files in the 'src' folder.",
      "fallback": false
    }
  },
  "plugin": [
    "opencode-antigravity-auth@1.5.1"
  ],
  "provider": {
    "openrouter": {
      "name": "OpenRouter",
      "models": {
        "z-ai/glm-5": {
          "name": "Z.ai GLM 5",
          "limit": {
            "context": 200000,
            "output": 130000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "openrouter/aurora-alpha": {
          "name": "Aurora Alpha",
          "limit": {
            "context": 128000,
            "output": 50000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "google": {
      "name": "Google",
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
